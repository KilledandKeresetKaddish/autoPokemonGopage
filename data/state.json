  "notes": {
    "source_health": {
      "fact": "events、raids、Hub、PokéBase 活动缓存及官方索引相对上次状态记录均有变化；gamemaster 刷新后内容不变，Hub 两份 Max 榜内容不变。",
      "decision": "增量补全活动与当前推荐；未变化的结构化攻手、防守榜保持已核验版本。"
    },
    "operator_note": {
      "fact": "管理员要求更新已公布新活动，以小拉达聚焦时刻为例，并进行完整查缺补漏。",
      "decision": "补入 XXS 小拉达概率提升与进化经验 ×2 的细节，补齐 feed 已公布但日历缺少的 4 条暮光小径赛季尾段对战档期；Spot Atlas 与精选列表未改。"
    },
    "rotation_note": {
      "fact": "Hub 9 月月度总览与现有 rotations.json 的 5★、超级及 Max 档期一致，今日超级终章第 2 天的 17 种超级 Boss 已与全天 raid-battles 抽屉逐项匹配。",
      "decision": "rotations.json 无需修改；保留已通过 preflight 的角标与抽屉契约。"
    },
    "source_gap": {
      "fact": "当前 raids 缓存页面标注为 9 月 5 日超级终章第 1 天，而运行日期为 9 月 6 日。",
      "decision": "当前推荐改按已核验的超级终章第 2 天事件页与既有日历/角标数据；不将第 1 天实时池误写为今日池。"
    }
  },
